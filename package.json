{
  "name": "swindirectory",
  "private": true,
  "version": "0.1.0",
  "description": "A Swinburne-inspired university course and tutor directory.",
  "engines": {
    "node": ">=16.20.0",
    "npm": ">=8.19.0"
  },
  "contributors": [
    "Mudabbirul Saad"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mercury": "vite build && node scripts/write-mercury-htaccess.js",
    "preview": "vite preview",
    "server": "node backend/index.js",
    "db:init": "node backend/setup_db.js",
    "db:seed": "node backend/seed_swinburne.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bcryptjs": "2.4.3",
    "bootstrap": "^5.3.8",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.3",
    "mariadb": "3.4.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "vite": "^4.5.14"
  }
}
